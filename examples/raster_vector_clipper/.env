# MinIO S3 Storage Configuration
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
AWS_ENDPOINT_URL=http://minio:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_DEFAULT_REGION=us-east-1
MINIO_REGION=us-east-1

PYTHONPATH=/app
PYTHONBUFFERED=1

DOCKER_BUILDKIT=1

INPUT_JSON=[{"name":"input_raster","type":"url","format":"raster","is_artifact":true,"value":"s3://clayrunner/inputs/some_raster.tif"},{"name":"input_vector","type":"url","format":"vector","is_artifact":true,"value":"s3://clayrunner/inputs/some_vector.geojson"}]
REMOTE_OUTPUT_PATH=s3://clayrunner/outputs
REMOTE_INPUT_PATH=s3://clayrunner/inputs
