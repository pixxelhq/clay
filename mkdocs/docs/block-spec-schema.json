{
    "$schema": "http://json-schema.org/draft-06/schema#",
    "$ref": "#/definitions/schema",
    "definitions": {
        "schema": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "kind": {
                    "type": "string"
                },
                "type": {
                    "type": "string"
                },
                "name": {
                    "type": "string"
                },
                "version": {
                    "type": "string"
                },
                "title": {
                    "type": "string"
                },
                "status": {
                    "type": "string"
                },
                "description": {
                    "type": "string"
                },
                "author": {
                    "type": "string"
                },
                "tags": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "resources": {
                    "$ref": "#/definitions/Resources"
                },
                "parameters": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/Parameter"
                    }
                },
                "inputs": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/Put"
                    }
                },
                "outputs": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/Put"
                    }
                },
                "build": {
                    "$ref": "#/definitions/Build"
                },
                "runtime_opts": {
                    "$ref": "#/definitions/RuntimeOpts"
                },
                "options": {
                    "$ref": "#/definitions/Options"
                },
                "catalog_content_url": {
                    "type": "string"
                }
            },
            "required": [
                "author",
                "build",
                "catalog_content_url",
                "description",
                "inputs",
                "kind",
                "name",
                "options",
                "outputs",
                "parameters",
                "resources",
                "runtime_opts",
                "status",
                "tags",
                "title",
                "type",
                "version"
            ],
            "title": "schema"
        },
        "Build": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "python-version": {
                    "type": "string"
                },
                "conda": {
                    "type": "boolean"
                },
                "gdal": {
                    "type": "boolean"
                },
                "apt-get": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "requirements": {
                    "type": "string"
                }
            },
            "required": [
                "apt-get",
                "conda",
                "gdal",
                "python-version",
                "requirements"
            ],
            "title": "Build"
        },
        "Put": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "name": {
                    "type": "string"
                },
                "format": {
                    "type": "string"
                },
                "type": {
                    "type": "string"
                },
                "is_artifact": {
                    "type": "boolean"
                },
                "properties": {
                    "anyOf": [
                        {
                            "$ref": "#/definitions/Properties"
                        },
                        {
                            "type": "null"
                        }
                    ]
                }
            },
            "required": [
                "format",
                "name",
                "type"
            ],
            "title": "Put"
        },
        "Properties": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "geometry": {
                    "type": "string"
                }
            },
            "required": [
                "geometry"
            ],
            "title": "Properties"
        },
        "Options": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "dry_run": {
                    "type": "null"
                },
                "preview": {
                    "type": "null"
                },
                "generate_k8s_spec": {
                    "type": "boolean"
                }
            },
            "required": [
                "dry_run",
                "generate_k8s_spec",
                "preview"
            ],
            "title": "Options"
        },
        "Parameter": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "name": {
                    "type": "string"
                },
                "type": {
                    "type": "string"
                },
                "default": {
                    "type": "integer"
                }
            },
            "required": [
                "default",
                "name",
                "type"
            ],
            "title": "Parameter"
        },
        "Resources": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "cpu": {
                    "$ref": "#/definitions/CPU"
                },
                "mem": {
                    "$ref": "#/definitions/CPU"
                }
            },
            "required": [
                "cpu",
                "mem"
            ],
            "title": "Resources"
        },
        "CPU": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "min": {
                    "type": "string"
                },
                "max": {
                    "type": "string"
                }
            },
            "required": [
                "max",
                "min"
            ],
            "title": "CPU"
        },
        "RuntimeOpts": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
                "image": {
                    "type": "string"
                },
                "K8sJobConfig": {
                    "type": "null"
                },
                "gpu": {
                    "type": "boolean"
                }
            },
            "required": [
                "K8sJobConfig",
                "gpu",
                "image"
            ],
            "title": "RuntimeOpts"
        }
    }
}
