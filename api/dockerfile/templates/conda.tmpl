FROM continuumio/miniconda3

RUN apt-get update && \
    apt-get install -y {{ .Build.AptGet | join }} && \
    pip3 install --upgrade pip && \

COPY {{ .Build.Requirements }} .

RUN conda env create --file {{ .Build.Requirements }} && conda clean --all --yes
ENV PATH /opt/conda/envs/$(head -1 {{ .Build.Requirements }} | cut -d' ' -f2)/bin:$PATH

{{ if .Build.UseGdal }}
RUN conda install --yes -c conda-forge gdal
{{ else }}
{{ end }}

RUN --mount=type=secret,id=GITLAB_TOKEN \
    GITLAB_TOKEN_=$(cat /run/secrets/GITLAB_TOKEN) && \
    pip3 install --no-cache-dir \
    clay --index-url https://gitlab+deploy-token-1735743:$GITLAB_TOKEN_@gitlab.com/api/v4/projects/38508365/packages/pypi/simple

COPY {{ .SourceCodeFolder }} /app
COPY {{ .ModelSpecificationPath }} /app/specification.yaml
ENV SPECIFICATION_PATH=/app/specification.yaml

WORKDIR /app

{{ if .UseHttpRunner }}
EXPOSE 8000
CMD ["python3", "entry.py"]
{{ else }}
ENTRYPOINT ["python3", "entry.py"]
{{ end }}
