                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/http.RegistryResponse-any"
                        }
                    }
                }
            },
            "post": {
                "description": "publish the specific version of the block.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Block"
                ],
                "summary": "Publish the block to clay registry",
                "parameters": [
                    {
                        "description": "Block to create",
                        "name": "body",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/http.CreateBlockRequest"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/http.RegistryResponse-http_CreateBlockResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/http.RegistryResponse-any"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/http.RegistryResponse-any"
                        }
                    }
                }
            }
        },
        "/v1/blocks/{name}": {
            "get": {
                "description": "Returns all the versions of the block name.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Block"
                ],
                "summary": "Get block by name.",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Name of the block",
                        "name": "name",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
