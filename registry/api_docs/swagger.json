                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/http.RegistryResponse-any"
                        }
                    }
                }
            }
        },
        "/v1/blocks/{name}/versions/{version}": {
            "get": {
                "description": "Returns the block for the given version and name.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "Block"
                ],
                "summary": "Get block by name and version.",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Name of the block",
                        "name": "name",
                        "in": "path",
                        "required": true
                    },
                    {
                        "type": "string",
                        "description": "Version of the block",
                        "name": "version",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/http.RegistryResponse-http_GetBlockByNameAndVersion"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/http.RegistryResponse-any"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/http.RegistryResponse-any"
                        }
                    }
                }
            }
        }
